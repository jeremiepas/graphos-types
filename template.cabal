name:                my-lib
version:             0.1.0.0
build-type:          Simple
cabal-version:       >=1.10

flag dev
  description: Enable development mode
  default: False

library
  exposed-modules:     MyLib
  hs-source-dirs:      src
  build-depends:       base >= 4.7 && < 5
  default-language:    Haskell2010
  if flag(dev)
    ghc-options: -Werror
